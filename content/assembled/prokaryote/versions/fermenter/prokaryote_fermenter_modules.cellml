<math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq />
        <ci>membrane__A_mem</ci>
        <apply>
          <times />
          <cn cellml:units="dimensionless">2.0</cn>
          <pi />
          <ci>R_cell_mod_membrane</ci>
          <ci>h_cell_mod_membrane</ci>
        </apply>
      </apply>
      <apply>
        <eq />
        <ci>membrane__Vol</ci>
        <apply>
          <times />
          <pi />
          <apply>
            <power />
            <ci>R_cell_mod_membrane</ci>
            <cn cellml:units="dimensionless">2.0</cn>
          </apply>
          <ci>h_cell_mod_membrane</ci>
          <cn type="e-notation" cellml:units="m3_per_um3">1<sep />-18</cn>
        </apply>
      </apply>
      <apply>
        <eq />
        <ci>membrane__Cm</ci>
        <apply>
          <times />
          <ci>c_m_mod_membrane</ci>
          <ci>membrane__A_mem</ci>
          <cn cellml:units="picoF_cm2_per_uF_um2">0.01</cn>
        </apply>
      </apply>
      <apply>
        <eq />
        <apply>
          <diff />
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>membrane__V</ci>
        </apply>
        <apply>
          <divide />
          <apply>
            <times />
            <cn cellml:units="milliV_per_kiloV">1000000.0</cn>
            <apply>
              <minus />
              <ci>I_in_mod_membrane</ci>
              <ci>multiport_sum_mod_membrane_i_ion__i_ion</ci>
            </apply>
          </apply>
          <ci>membrane__Cm</ci>
        </apply>
      </apply>
    </math>
  
<math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq />
        <ci>Na_K__E_K</ci>
        <apply>
          <times />
          <apply>
            <divide />
            <apply>
              <times />
              <ci>R</ci>
              <ci>T</ci>
            </apply>
            <ci>F</ci>
          </apply>
          <apply>
            <ln />
            <apply>
              <divide />
              <ci>Ko_mod_Na_K</ci>
              <ci>Na_K__Ki</ci>
            </apply>
          </apply>
          <cn cellml:units="milliV_per_V">1000</cn>
        </apply>
      </apply>
      <apply>
        <eq />
        <ci>Na_K__E_Na</ci>
        <apply>
          <times />
          <apply>
            <divide />
            <apply>
              <times />
              <ci>R</ci>
              <ci>T</ci>
            </apply>
            <ci>F</ci>
          </apply>
          <apply>
            <ln />
            <apply>
              <divide />
              <ci>Nao_mod_Na_K</ci>
              <ci>Na_K__Nai</ci>
            </apply>
          </apply>
          <cn cellml:units="milliV_per_V">1000</cn>
        </apply>
      </apply>
      <apply>
        <eq />
        <apply>
          <diff />
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>Na_K__Nai</ci>
        </apply>
        <apply>
          <divide />
          <ci>multiport_sum_mod_Na_K_j_Na_total__j_Na_total</ci>
          <ci>membrane__Vol</ci>
        </apply>
      </apply>
      <apply>
        <eq />
        <apply>
          <diff />
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>Na_K__Ki</ci>
        </apply>
        <apply>
          <divide />
          <ci>multiport_sum_mod_Na_K_j_K_total__j_K_total</ci>
          <ci>membrane__Vol</ci>
        </apply>
      </apply>
    </math>
  
<math xmlns:cellml="http://www.cellml.org/cellml/2.0#" xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq />
        <ci>Ca__CaB_Cai</ci>
        <apply>
          <minus />
          <ci>B_Ca_total_mod_Ca</ci>
          <ci>Ca__B_Cai</ci>
        </apply>
      </apply>
      <apply>
        <eq />
        <apply>
          <diff />
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>Ca__B_Cai</ci>
        </apply>
        <apply>
          <minus />
          <apply>
            <times />
            <ci>k_unbind_Ca_mod_Ca</ci>
            <ci>Ca__CaB_Cai</ci>
          </apply>
          <apply>
            <times />
            <ci>k_bind_Ca_mod_Ca</ci>
            <ci>Ca__Cai</ci>
            <ci>Ca__B_Cai</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq />
        <apply>
          <diff />
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>Ca__Cai</ci>
        </apply>
        <apply>
          <minus />
          <apply>
            <plus />
            <apply>
              <divide />
              <ci>multiport_sum_mod_Ca_j_Ca_in__j_Ca_in</ci>
              <ci>membrane__Vol</ci>
            </apply>
            <apply>
              <times />
              <ci>k_unbind_Ca_mod_Ca</ci>
              <ci>Ca__CaB_Cai</ci>
            </apply>
          </apply>
          <apply>
            <times />
            <ci>k_bind_Ca_mod_Ca</ci>
            <ci>Ca__Cai</ci>
            <ci>Ca__B_Cai</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq />
        <ci>Ca__Ca_total</ci>
        <apply>
          <plus />
          <ci>Ca__Cai</ci>
          <ci>Ca__CaB_Cai</ci>
        </apply>
      </apply>
    </math>
  
<math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq />
        <apply>
          <diff />
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>H__H_i</ci>
        </apply>
        <apply>
          <divide />
          <apply>
            <divide />
            <apply>
              <plus />
              <ci>multiport_sum_mod_H_j_H_in__j_H_in</ci>
              <ci>multiport_sum_mod_H_j_H_prod__j_H_prod</ci>
            </apply>
            <ci>membrane__Vol</ci>
          </apply>
          <apply>
            <plus />
            <cn cellml:units="dimensionless">1.0</cn>
            <apply>
              <divide />
              <ci>beta_H_mod_H</ci>
              <apply>
                <times />
                <apply>
                  <ln />
                  <cn cellml:units="dimensionless">10.0</cn>
                </apply>
                <ci>H__H_i</ci>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq />
        <ci>H__pH_i</ci>
        <apply>
          <divide />
          <apply>
            <minus />
            <apply>
              <ln />
              <apply>
                <divide />
                <ci>H__H_i</ci>
                <ci>c_std_mod_H</ci>
              </apply>
            </apply>
          </apply>
          <apply>
            <ln />
            <cn cellml:units="dimensionless">10.0</cn>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq />
        <ci>H__pH_o</ci>
        <apply>
          <divide />
          <apply>
            <minus />
            <apply>
              <ln />
              <apply>
                <divide />
                <ci>H_o_mod_H</ci>
                <ci>c_std_mod_H</ci>
              </apply>
            </apply>
          </apply>
          <apply>
            <ln />
            <cn cellml:units="dimensionless">10.0</cn>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq />
        <ci>H__E_H</ci>
        <apply>
          <times />
          <apply>
            <divide />
            <apply>
              <times />
              <ci>R</ci>
              <ci>T</ci>
            </apply>
            <ci>F</ci>
          </apply>
          <apply>
            <ln />
            <apply>
              <divide />
              <ci>H_o_mod_H</ci>
              <ci>H__H_i</ci>
            </apply>
          </apply>
          <cn cellml:units="milliV_per_V">1000.0</cn>
        </apply>
      </apply>
      <apply>
        <eq />
        <ci>H__H_total_rel</ci>
        <apply>
          <minus />
          <ci>H__H_i</ci>
          <apply>
