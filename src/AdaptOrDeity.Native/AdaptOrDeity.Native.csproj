<Project Sdk="Microsoft.NET.Sdk">
  <!-- The simulation as a NativeAOT shared library (aod_sim) with C entry points, which Unity loads as a native plugin
       (decision 2026-10-11; docs/plans/parallel-and-gpu.md step 7). Build: tools/scripts/build_native_sim.sh. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <AssemblyName>aod_sim</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcInstructionSet Condition="$(RuntimeIdentifier.EndsWith('-x64'))">x86-x64-v3</IlcInstructionSet>
  </PropertyGroup>
  <!-- The cell model in libcuflynx's generated C (src/AdaptOrDeity.Cells, tools/scripts/build_cell_library.py),
       linked in when built: libaod_cell_static.a (Linux, macOS) or aod_cell_static.lib (Windows). -->
  <ItemGroup Condition="Exists('bin/cells/libaod_cell_static.a') Or Exists('bin/cells/aod_cell_static.lib')">
    <DirectPInvoke Include="aod_cell" />
    <NativeLibrary Include="bin/cells/libaod_cell_static.a" Condition="Exists('bin/cells/libaod_cell_static.a')" />
    <NativeLibrary Include="bin/cells/aod_cell_static.lib" Condition="Exists('bin/cells/aod_cell_static.lib')" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../AdaptOrDeity.Game.Session/AdaptOrDeity.Game.Session.csproj" />
  </ItemGroup>
</Project>
